# Copy to cloud/.env.cloud and fill in real values, then run:
#   cd cloud && docker compose -f docker-compose.cloud.yml --env-file .env.cloud up -d
# (or, from the repo root, running both stacks together:)
#   docker compose --env-file cloud/.env.cloud -f docker-compose.yml -f cloud/docker-compose.cloud.yml up -d

# Cloud DB password (separate DB/volume from the station's local db).
CLOUD_DB_PASSWORD=change-me

# First-run bootstrap admin — creates one T3 admin account on first startup
# if no admin exists yet. Log in, create a real admin account for yourself,
# then clear these two (they sit in plain text in this file).
CLOUD_ADMIN_EMAIL=you@example.com
CLOUD_ADMIN_PASSWORD=change-me

# Optional: override host-side ports if the defaults collide with something
# else already running on this box.
# CLOUD_DB_PORT=5433
# CLOUD_API_PORT=8100
# CLOUD_FRONTEND_PORT=5100

# ── License server (bundled in this file's docker-compose.cloud.yml) ──────────
# See ../license-server/README.md — a simple database of hand-issued,
# use-limited passphrases; no signing keys, no license files.
# LICENSE_SERVER_ADMIN_TOKEN_HASH is a HASH, not the token itself — run
# `python3 ../license-server/hash_secret.py` to generate it; never put the
# plaintext secret here. MASTER_PASSPHRASE optionally overrides the
# auto-seeded unlimited-use, never-expiring master code (default
# "PermissionGranted200").
# LICENSE_SERVER_ADMIN_TOKEN_HASH=
# MASTER_PASSPHRASE=
# LICENSE_SERVER_PORT=8200

# ── This Cloud Utility's own license ────────────────────────────────────────
# One passphrase, always phoned home to the license server — no offline
# verification. CLOUD_LICENSE_KEY below is an INITIAL-DEPLOYMENT
# CONVENIENCE ONLY — it seeds the license exactly once, on a brand new
# deployment with an empty database. Activating or switching to a new
# passphrase after that is done from Admin -> License in the cloud frontend
# (no restart) — this var is never read again once a license is configured
# either way. Leave it blank to configure entirely from the UI on first
# login instead.
#
# Deployment/infra settings below DO always come from env, never the UI:
# LICENSE_SERVER_URL=http://license-server:8000
# LICENSE_CHECK_INTERVAL_HOURS=24
# LICENSE_GRACE_DAYS=45
#
# Seed (first boot only, see above):
# CLOUD_LICENSE_KEY=                     # a passphrase issued via license-server's POST /admin/licenses
