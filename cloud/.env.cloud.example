# Copy to cloud/.env.cloud and fill in real values, then run:
#   cd cloud && docker compose -f docker-compose.cloud.yml --env-file .env.cloud up -d
# (or, from the repo root, running both stacks together:)
#   docker compose --env-file cloud/.env.cloud -f docker-compose.yml -f cloud/docker-compose.cloud.yml up -d

# Cloud DB password (separate DB/volume from the station's local db).
CLOUD_DB_PASSWORD=change-me

# First-run bootstrap admin — creates one T3 admin account on first startup
# if no admin exists yet. Log in, create a real admin account for yourself,
# then clear these two (they sit in plain text in this file).
CLOUD_ADMIN_EMAIL=you@example.com
CLOUD_ADMIN_PASSWORD=change-me

# Optional: override host-side ports if the defaults collide with something
# else already running on this box.
# CLOUD_DB_PORT=5433
# CLOUD_API_PORT=8100
# CLOUD_FRONTEND_PORT=5100

# ── License server (bundled in this file's docker-compose.cloud.yml) ──────────
# See ../license-server/README.md. Guard LICENSE_SERVER_ADMIN_TOKEN like a
# production secret.
# LICENSE_SERVER_ADMIN_TOKEN=change-me
# UNLIMITED_LICENSE_PASSPHRASE=PermissionGranted200
# LICENSE_SERVER_PORT=8200

# ── This Cloud Utility's own license (optional — leave CLOUD_LICENSE_TYPE
#    blank to run unconfigured/unlicensed) ──────────────────────────────────
# CLOUD_LICENSE_TYPE=annual              # "annual" | "unlimited"
# CLOUD_LICENSE_KEY=                     # Annual — issued by license-server's /admin/licenses/annual
# LICENSE_SERVER_URL=http://license-server:8000
# LICENSE_CHECK_INTERVAL_HOURS=24
# LICENSE_GRACE_DAYS=45
# CLOUD_LICENSE_FILE=                    # Unlimited — signed license file contents, inline...
# CLOUD_LICENSE_FILE_PATH=               # ...or a mounted path to it
# LICENSE_SIGNING_PUBLIC_KEY=            # PEM public key from license-server's GET /license/public-key
