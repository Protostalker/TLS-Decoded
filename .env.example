# Copy this file to .env and fill in real values
# cp .env.example .env

# Database password (used by db, api, and poller services)
DB_PASSWORD=tls_local

# Secret key for API session tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production

# Optional: override serial port if different from config/tls-decoded.yaml
# SERIAL_PORT=/dev/ttyUSB0
